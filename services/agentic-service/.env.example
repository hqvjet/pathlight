# 🚀 Agentic Service Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# 🔑 Required - OpenAI Configuration
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# ☁️  Required - AWS Configuration
# =============================================================================
ACCESS_KEY_ID=your-aws-access-key-here
SECRET_ACCESS_KEY=your-aws-secret-access-key-here
REGION=ap-northeast-1
S3_BUCKET_NAME=your-s3-bucket-name-here

# =============================================================================
# 🔍 Optional - OpenSearch Configuration (auto-disabled in local mode)
# =============================================================================
OPENSEARCH_ENABLED=false
OPENSEARCH_HOST=your-opensearch-endpoint-here
OPENSEARCH_USERNAME=your-opensearch-username-here
OPENSEARCH_PASSWORD=your-opensearch-password-here
OPENSEARCH_PORT=443

# =============================================================================
# 🛠️  Development Configuration
# =============================================================================
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_PORT=8000

# =============================================================================
# 🗄️  Database (Postgres on EC2/RDS)
# =============================================================================
# Full SQLAlchemy URL, e.g.:
# DATABASE_URL=postgresql+psycopg2://username:password@ec2-host-or-rds-endpoint:5432/pathlight
DATABASE_URL=
# Used when inserting a Course row (owner). Replace with actual user id from auth-service.
DEFAULT_USER_ID=system

# =============================================================================
# 🧪 Testing Configuration (automatically detected)
# =============================================================================
# TESTING=true  # Uncomment for test mode
# PYTEST_CURRENT_TEST=1  # Set automatically by pytest

# =============================================================================
# 📁 File Processing Configuration (optional overrides)
# =============================================================================
# MAX_FILE_SIZE_BYTES=104857600  # 100MB default
# MAX_TOKENS_PER_CHUNK=512       # Default chunk size
# OPENSEARCH_INDEX_NAME=pathlight_materials  # Default index name
OPENSEARCH_INDEX_NAME=your_index_name_here

# Development Overrides (OPTIONAL)
# Uncomment only if you need to override defaults
# OPENSEARCH_ENABLED=false
# SKIP_OPENSEARCH_LOCAL=true   # default: skip OS init in local to avoid private subnet issues
# FORCE_OPENSEARCH_LOCAL=true

# =============================================================================
# 🧾 DynamoDB tracking (simple status table)
# =============================================================================
# Name of the table to track generation status. Must exist, or enable auto-create.
DDB_TABLE_NAME=pathlight-agentic-status
# If true, the service will create the table automatically when not present.
DDB_AUTO_CREATE_TABLE=false
