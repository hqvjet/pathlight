# ==== DATABASE CONFIGURATION ====
# Kết nối đến PostgreSQL trên RDS hoặc container riêng
DATABASE_URL=postgresql://postgres:your-strong-password@your-db-host.amazonaws.com:5432/pathlight

# ==== JWT AUTHENTICATION CONFIG ====
# Key bảo mật JWT access và refresh token - nên lưu trong AWS Secrets Manager
JWT_SECRET_KEY=replace-with-strong-secret-key
JWT_REFRESH_SECRET_KEY=replace-with-another-refresh-secret-key